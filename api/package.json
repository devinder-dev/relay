{
  "name": "relay-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "test:unit": "bun test src",
    "test:db": "bash scripts/test-db.sh test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "dbmate --wait --wait-timeout 60s --no-dump-schema --migration-lock --migration-lock-timeout 30s migrate",
    "db:up": "bash scripts/test-db.sh up",
    "db:down": "bash scripts/test-db.sh down"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "dbmate": "2.37.0",
    "fastify": "5.12.7",
    "ipaddr.js": "2.5.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "6.0.3"
  }
}
